{
  "name": "msglab",
  "productName": "MsgLab",
  "version": "0.1.21",
  "description": "Generate, validate, explain and (later) send HL7 v2 messages for testing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pretest:e2e": "node -e \"for (const dir of ['allure-results', 'allure-report', 'playwright-report', 'test-results']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:open": "allure open allure-report"
  },
  "license": "MIT",
  "author": "Vadym \"Ailur\" Shevchenko",
  "homepage": "https://github.com/vads-cmd/MsgLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vads-cmd/MsgLab.git"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "electron": "^45.0.0"
  }
}
