{
  "name": "msglab",
  "productName": "MsgLab",
  "version": "0.1.29",
  "description": "Generate, validate, explain and (later) send HL7 v2 messages for testing",
  "desktopName": "msglab.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pretest:e2e": "node -e \"for (const dir of ['allure-results', 'allure-report', 'playwright-report', 'test-results']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:open": "allure open allure-report",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "author": "Vadym \"Ailur\" Shevchenko",
  "homepage": "https://github.com/vads-cmd/MsgLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vads-cmd/MsgLab.git"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "afterSign": "scripts/adhoc-sign.js",
    "appId": "io.github.vads-cmd.msglab",
    "productName": "MsgLab",
    "copyright": "Copyright © 2026 Vadym \"Ailur\" Shevchenko",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "src/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "icon": "assets/app-icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)"
      ]
    },
    "nsis": {
      "artifactName": "MsgLab-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/linux-icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "maintainer": "Vadym Shevchenko <vads.cmd@gmail.com>"
    }
  }
}
